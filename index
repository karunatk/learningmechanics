          <span class="text-xs font-semibold text-slate-200">${node.label}</span>
        `;
        palette.appendChild(btn);
      });

      renderAssemblySlots();
    }

    function renderAssemblySlots() {
      const container = document.getElementById('assemblySlots');
      container.innerHTML = '';

      for (let i = 0; i < 5; i++) {
        const node = state.assembledNodes[i];
        const slot = document.createElement('div');
        
        if (node) {
          slot.className = "p-2 rounded-xl bg-brand-950/60 border border-brand-500/40 text-xs flex items-center justify-between shadow-sm animate-pulse-once";
          slot.innerHTML = `
            <div class="flex items-center gap-2 overflow-hidden">
              <i class="fa-solid ${node.icon} text-brand-400 shrink-0"></i>
              <span class="font-bold text-slate-200 truncate text-[11px]">${node.label}</span>
            </div>
            <button onclick="removeNodeFromPipeline(${i})" class="text-slate-400 hover:text-rose-400 shrink-0 ml-1">
              <i class="fa-solid fa-xmark"></i>
            </button>
          `;
        } else {
          slot.className = "p-2 rounded-xl bg-slate-900/40 border border-dashed border-slate-800 text-xs flex items-center justify-center text-slate-600 font-mono text-[11px]";
          slot.innerText = `Slot #${i + 1}`;
        }
        container.appendChild(slot);
      }

      document.getElementById('assembledCount').innerText = state.assembledNodes.length;

      // Check order validity
      const isComplete = state.assembledNodes.length === 5;
      const isValid = isComplete && state.assembledNodes.every((n, idx) => n.id === state.ragNodes[idx].id);

      const statusEl = document.getElementById('pipelineStatus');
      const runBtn = document.getElementById('runPipelineBtn');

      if (isValid) {
        statusEl.innerText = "Valid Pipeline ✓";
        statusEl.className = "text-neon-green text-[11px] font-mono font-bold";
        runBtn.disabled = false;
        runBtn.className = "text-xs font-bold px-3 py-1.5 rounded-xl bg-neon-cyan text-slate-950 hover:bg-cyan-300 transition flex items-center gap-1.5 shadow-lg shadow-neon-cyan/20 cursor-pointer";
      } else if (isComplete) {
        statusEl.innerText = "Invalid Sequence ✗";
        statusEl.className = "text-rose-400 text-[11px] font-mono font-bold";
        runBtn.disabled = true;
        runBtn.className = "text-xs font-bold px-3 py-1.5 rounded-xl bg-slate-800 text-slate-500 cursor-not-allowed transition flex items-center gap-1.5";
      } else {
        statusEl.innerText = "Incomplete";
        statusEl.className = "text-amber-400 text-[11px] font-mono";
        runBtn.disabled = true;
        runBtn.className = "text-xs font-bold px-3 py-1.5 rounded-xl bg-slate-800 text-slate-500 cursor-not-allowed transition flex items-center gap-1.5";
      }
    }

    function addNodeToPipeline(node) {
      if (state.assembledNodes.length < 5) {
        // Prevent duplicate addition
        if (!state.assembledNodes.some(n => n.id === node.id)) {
          state.assembledNodes.push(node);
          renderAssemblySlots();
        }
      }
    }

    function removeNodeFromPipeline(index) {
      state.assembledNodes.splice(index, 1);
      renderAssemblySlots();
    }

    function resetNodeAssembler() {
      state.assembledNodes = [];
      renderAssemblySlots();
      document.getElementById('pipelineLog').innerText = "Select nodes above to construct a valid Retrieval-Augmented Generation (RAG) system.";
