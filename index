        log.innerHTML += `<span class="text-slate-300">[00:00.6] Retrieved Top-3 context chunks. Injecting into LLM Prompt...</span><br>`;
      }, 800);

      setTimeout(() => {
        log.innerHTML += `<span class="text-neon-green font-bold">[00:00.9] Guardrail Verified ✓ Answer generated with 0% hallucination score!</span>`;
      }, 1200);
