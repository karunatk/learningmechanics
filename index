    function initNodeAssembler() {
      const palette = document.getElementById('nodePalette');
      palette.innerHTML = '';
      
      // Shuffle palette to make puzzle engaging
      const shuffled = [...state.ragNodes].sort(() => Math.random() - 0.5);

      shuffled.forEach(node => {
        const btn = document.createElement('button');
        btn.className = "p-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-800 text-left transition flex items-center gap-2 group";
