    function updateProfiler() {
      const temp = parseFloat(document.getElementById('tempSlider').value);
      const ctx = parseInt(document.getElementById('contextSlider').value);
      const guard = parseInt(document.getElementById('guardSlider').value);
      const topP = parseFloat(document.getElementById('topPSlider').value);

      document.getElementById('tempVal').innerText = temp.toFixed(1);
      document.getElementById('contextVal').innerText = ctx.toLocaleString();
      document.getElementById('guardVal').innerText = guard === 1 ? "Low" : guard === 2 ? "Medium" : "Strict";
      document.getElementById('topPVal').innerText = topP.toFixed(2);

      // Calculations
      let hallucinationRisk = Math.round((temp * 35) + (ctx / 32768 * 15) - (guard * 8));
      hallucinationRisk = Math.max(2, Math.min(98, hallucinationRisk));

      let latency = Math.round(180 + (ctx / 100) + (temp * 40));
      let cost = ((ctx / 1000) * 0.002).toFixed(3);

      let creativityStr = temp > 0.9 ? "Very High (Unpredictable)" : temp > 0.5 ? "Balanced" : "Deterministic (Factual)";

      document.getElementById('metricCreativity').innerText = creativityStr;
      document.getElementById('metricHallucination').innerText = hallucinationRisk + "%";
      document.getElementById('metricHallucination').className = `text-sm font-bold mt-0.5 ${hallucinationRisk > 40 ? 'text-rose-400' : 'text-emerald-400'}`;
      
      document.getElementById('metricLatency').innerText = latency + "ms";
      document.getElementById('metricCost').innerText = "$" + cost;

      // Sample text output variation based on temp
      const sampleText = document.getElementById('profilerSampleOutput');
      if (temp < 0.4) {
        sampleText.innerText = '"Quantum computing processes data using qubits based on deterministic physics principles."';
      } else if (temp < 0.9) {
        sampleText.innerText = '"Quantum computing utilizes qubits that can exist in superposition to analyze complex possibilities simultaneously."';
      } else {
        sampleText.innerText = '"Quantum realm cybernetics transcend dimensional space through neon-entangled algorithmic dreams!"';
      }
    }

    function scrubToStep(stepIndex) {
      state.scrubberStep = parseInt(stepIndex);
      renderScrubberStep();
    }

    function stepScrubber(delta) {
      let newStep = state.scrubberStep + delta;
      if (newStep < 1) newStep = 1;
      if (newStep > state.scrubberStepsData.length) newStep = state.scrubberStepsData.length;
      state.scrubberStep = newStep;
      document.getElementById('scrubberRange').value = newStep;
      renderScrubberStep();
    }

    function renderScrubberStep() {
      const data = state.scrubberStepsData[state.scrubberStep - 1];
      document.getElementById('currentStepNum').innerText = state.scrubberStep;
      document.getElementById('totalStepsNum').innerText = state.scrubberStepsData.length;

      document.getElementById('stepTitle').innerText = data.title;
      document.getElementById('stepThought').innerText = data.thought;
      document.getElementById('stepTool').innerText = data.tool;
      document.getElementById('stepMemory').innerText = data.memory;

      const iconEl = document.getElementById('stepIcon');
      iconEl.className = `fa-solid ${data.icon} text-neon-green text-sm`;
    }

    function toggleAutoPlayScrubber() {
      const btn = document.getElementById('autoPlayBtn');
      const icon = document.getElementById('playIcon');

      if (state.isAutoPlaying) {
        clearInterval(state.autoPlayTimer);
        state.isAutoPlaying = false;
        btn.innerHTML = `<i class="fa-solid fa-play mr-1"></i> Play Loop`;
      } else {
        state.isAutoPlaying = true;
        btn.innerHTML = `<i class="fa-solid fa-pause mr-1"></i> Pause`;
        state.autoPlayTimer = setInterval(() => {
          if (state.scrubberStep >= state.scrubberStepsData.length) {
            state.scrubberStep = 1;
          } else {
            state.scrubberStep++;
          }
          document.getElementById('scrubberRange').value = state.scrubberStep;
          renderScrubberStep();
        }, 1500);
      }
    }

